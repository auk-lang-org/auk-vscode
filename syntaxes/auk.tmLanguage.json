{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Auk",
  "scopeName": "source.auk",
  "fileTypes": [
    "auk"
  ],
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#chars"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#hole"
        },
        {
          "include": "#fn-decl"
        },
        {
          "include": "#type-decl"
        },
        {
          "include": "#uses"
        },
        {
          "include": "#test-decl"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#block"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.auk",
          "begin": "///(?!/)",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.auk"
            }
          }
        },
        {
          "name": "comment.line.double-slash.auk",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.auk"
            }
          }
        },
        {
          "name": "comment.block.auk",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.auk"
            }
          },
          "patterns": [
            {
              "include": "#block-comment-nested"
            }
          ]
        }
      ]
    },
    "block-comment-nested": {
      "name": "comment.block.auk",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment-nested"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.raw.auk",
          "begin": "(r)(\"\"\")",
          "end": "\"\"\"",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.auk"
            },
            "2": {
              "name": "punctuation.definition.string.begin.auk"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.auk"
            }
          }
        },
        {
          "name": "string.quoted.double.raw.auk",
          "begin": "(r)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": {
              "name": "storage.type.string.auk"
            },
            "2": {
              "name": "punctuation.definition.string.begin.auk"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.auk"
            }
          }
        },
        {
          "name": "string.quoted.triple.auk",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.auk"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.auk"
            }
          },
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        },
        {
          "name": "string.quoted.double.auk",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.auk"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.auk"
            }
          },
          "patterns": [
            {
              "include": "#string-content"
            }
          ]
        }
      ]
    },
    "string-content": {
      "patterns": [
        {
          "name": "constant.character.escape.auk",
          "match": "\\\\(?:[ntr0\\\\\\\"']|u\\{[0-9a-fA-F]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.auk",
          "match": "\\\\."
        },
        {
          "name": "constant.character.escape.brace.auk",
          "match": "\\{\\{|\\}\\}"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.auk",
      "contentName": "meta.embedded.line.auk source.auk",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.auk"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.auk"
        }
      },
      "patterns": [
        {
          "include": "#format-spec"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "format-spec": {
      "match": "(:)([<>^]?[+\\-]?0?[0-9]*(?:\\.[0-9]+)?[a-zA-Z%]?)(?=\\})",
      "captures": {
        "1": {
          "name": "punctuation.separator.format.auk"
        },
        "2": {
          "name": "constant.other.format-spec.auk"
        }
      }
    },
    "block": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.auk"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.end.auk"
        }
      },
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.char.auk",
          "match": "(')(\\\\(?:[ntr0\\\\\\\"']|u\\{[0-9a-fA-F]{1,6}\\})|[^'\\\\\\n])(')",
          "captures": {
            "1": {
              "name": "punctuation.definition.char.begin.auk"
            },
            "2": {
              "patterns": [
                {
                  "name": "constant.character.escape.auk",
                  "match": "\\\\(?:[ntr0\\\\\\\"']|u\\{[0-9a-fA-F]{1,6}\\})"
                }
              ]
            },
            "3": {
              "name": "punctuation.definition.char.end.auk"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.auk",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.binary.auk",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.octal.auk",
          "match": "\\b0o[0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.float.auk",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+\\-]?[0-9][0-9_]*)?|[eE][+\\-]?[0-9][0-9_]*)\\b"
        },
        {
          "name": "constant.numeric.integer.auk",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "hole": {
      "name": "invalid.illegal.hole.auk",
      "match": "\\?\\?"
    },
    "fn-decl": {
      "match": "\\b(?:(async)\\s+)?(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.modifier.async.auk"
        },
        "2": {
          "name": "keyword.declaration.function.auk storage.type.function.auk"
        },
        "3": {
          "name": "entity.name.function.auk"
        }
      }
    },
    "type-decl": {
      "match": "\\b(struct|enum|shape)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.declaration.type.auk storage.type.auk"
        },
        "2": {
          "name": "entity.name.type.auk"
        }
      }
    },
    "test-decl": {
      "match": "\\b(test)\\s+(?=\\\")",
      "captures": {
        "1": {
          "name": "keyword.other.test.auk"
        }
      }
    },
    "uses": {
      "begin": "\\buses\\b",
      "end": "(?=[{=]|//|$)",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.uses.auk"
        }
      },
      "patterns": [
        {
          "name": "support.constant.effect.auk",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.comma.auk",
          "match": ","
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.auk",
          "match": "\\b(if|else|match|for|in|while|loop|break|continue|return|when|await|catch)\\b"
        },
        {
          "name": "keyword.declaration.auk storage.type.auk",
          "match": "\\b(fn|let|var|struct|enum|shape)\\b"
        },
        {
          "name": "storage.modifier.auk",
          "match": "\\b(pub|async|any)\\b"
        },
        {
          "name": "keyword.other.contract.auk",
          "match": "\\b(requires|ensures)\\b"
        },
        {
          "name": "keyword.other.auk",
          "match": "\\b(test|assert|imprint|peek|uses|is)\\b"
        },
        {
          "name": "constant.language.boolean.auk",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.none.auk",
          "match": "\\bnone\\b"
        },
        {
          "name": "support.function.builtin.auk",
          "match": "\\b(some|ok|err|fail)\\b"
        },
        {
          "name": "variable.language.self.auk",
          "match": "\\b(self|Self|result)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(int|float|bool|char|str|Value|[A-Z][A-Za-z0-9_]*)([?!])(?:([A-Z][A-Za-z0-9_]*))?",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#type-name"
                }
              ]
            },
            "2": {
              "name": "keyword.operator.type-suffix.auk"
            },
            "3": {
              "name": "entity.name.type.auk"
            }
          }
        },
        {
          "match": "(?<=[\\)\\]])([?!])(?=\\s*(?:\\buses\\b|\\{|=\\s|$))",
          "captures": {
            "1": {
              "name": "keyword.operator.type-suffix.auk"
            }
          }
        },
        {
          "include": "#type-name"
        }
      ]
    },
    "type-name": {
      "patterns": [
        {
          "name": "support.type.primitive.auk",
          "match": "\\b(int|float|bool|char|str|Value)\\b"
        },
        {
          "name": "entity.name.type.enum-member.auk variable.other.enummember.auk",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "entity.name.type.auk",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.auk",
          "match": "=>"
        },
        {
          "name": "keyword.operator.pipe.auk",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.optional-chain.auk",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.range.auk",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.arithmetic.wrapping.auk",
          "match": "[+\\-*]%"
        },
        {
          "name": "keyword.operator.arithmetic.power.auk",
          "match": "\\*\\*"
        },
        {
          "name": "keyword.operator.comparison.auk",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.auk",
          "match": "&&|\\|\\|"
        },
        {
          "name": "keyword.operator.assignment.compound.auk",
          "match": "<<=|>>=|[&|^]="
        },
        {
          "name": "keyword.operator.bitwise.shift.auk",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.assignment.compound.auk",
          "match": "[+\\-*/%]="
        },
        {
          "name": "keyword.operator.assignment.auk",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.auk",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.arithmetic.auk",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.try.auk",
          "match": "[?!]"
        },
        {
          "name": "keyword.operator.reference.auk",
          "match": "(?<=[(,])&|(?<=[(,] )&"
        },
        {
          "name": "keyword.operator.bitwise.auk",
          "match": "[&|^~]"
        }
      ]
    },
    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.auk"
        }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.auk",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.auk",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.auk",
          "match": "\\."
        },
        {
          "name": "punctuation.brackets.auk",
          "match": "[\\[\\]()]"
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.auk",
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
    }
  }
}