{
  "name": "auk-lang",
  "displayName": "Auk Language",
  "description": "Syntax highlighting, diagnostics, quick fixes, hover, go to definition and formatting for the Auk programming language",
  "version": "0.1.0",
  "publisher": "aukc",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Themes"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:auk",
    "onCommand:auk.run",
    "onCommand:auk.runWithArgs",
    "onCommand:auk.test",
    "onCommand:auk.debug",
    "onDebugResolve:auk",
    "onDebugDynamicConfigurations:auk"
  ],
  "contributes": {
    "languages": [
      {
        "id": "auk",
        "aliases": [
          "Auk",
          "auk"
        ],
        "extensions": [
          ".auk"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/auk.svg",
          "dark": "./icons/auk-dark.svg"
        }
      },
      {
        "id": "toml",
        "filenames": [
          "raft.toml"
        ]
      }
    ],
    "grammars": [
      {
        "language": "auk",
        "scopeName": "source.auk",
        "path": "./syntaxes/auk.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Ice Floe",
        "uiTheme": "vs",
        "path": "./themes/ice-floe-color-theme.json"
      },
      {
        "label": "Ice Floe Night",
        "uiTheme": "vs-dark",
        "path": "./themes/ice-floe-night-color-theme.json"
      }
    ],
    "configuration": {
      "title": "Auk",
      "properties": {
        "auk.path": {
          "type": "string",
          "default": "auk",
          "markdownDescription": "Path to the `auk` executable that runs the language server (`auk lsp`)."
        },
        "auk.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the JSON-RPC traffic between VS Code and the Auk language server."
        }
      }
    },
    "commands": [
      {
        "command": "auk.restartServer",
        "title": "Auk: Restart Language Server"
      },
      {
        "command": "auk.run",
        "title": "Auk: Run File",
        "icon": "$(play)"
      },
      {
        "command": "auk.runWithArgs",
        "title": "Auk: Run File with Arguments…",
        "icon": "$(debug-alt)"
      },
      {
        "command": "auk.test",
        "title": "Auk: Test File",
        "icon": "$(beaker)"
      },
      {
        "command": "auk.debug",
        "title": "Auk: Debug File",
        "icon": "$(debug-alt-small)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "auk.run",
          "when": "resourceLangId == auk",
          "group": "navigation@0"
        },
        {
          "command": "auk.runWithArgs",
          "when": "resourceLangId == auk",
          "group": "navigation@1"
        },
        {
          "command": "auk.test",
          "when": "resourceLangId == auk",
          "group": "navigation@2"
        },
        {
          "command": "auk.debug",
          "when": "resourceLangId == auk",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "auk.run",
          "when": "editorLangId == auk"
        },
        {
          "command": "auk.runWithArgs",
          "when": "editorLangId == auk"
        },
        {
          "command": "auk.test",
          "when": "editorLangId == auk"
        },
        {
          "command": "auk.debug",
          "when": "editorLangId == auk"
        }
      ]
    },
    "keybindings": [
      {
        "command": "auk.debug",
        "key": "f5",
        "when": "editorLangId == auk && !inDebugMode"
      },
      {
        "command": "auk.run",
        "key": "ctrl+f5",
        "mac": "ctrl+f5",
        "when": "editorLangId == auk && !inDebugMode"
      }
    ],
    "breakpoints": [
      {
        "language": "auk"
      }
    ],
    "debuggers": [
      {
        "type": "auk",
        "label": "Auk",
        "languages": [
          "auk"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .auk file to debug (with `fn main`).",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments for the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The program's working directory.",
                "default": "${fileDirname}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the start of `main`.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "auk",
            "request": "launch",
            "name": "Debug Auk file",
            "program": "${file}",
            "cwd": "${fileDirname}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Auk: Debug a file",
            "description": "Debug an Auk program",
            "body": {
              "type": "auk",
              "request": "launch",
              "name": "Debug Auk file",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${fileDirname}\""
            }
          }
        ]
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
