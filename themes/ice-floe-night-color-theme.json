  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7891a0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords (fn, let, enum, uses)",
      "scope": [
        "keyword.other",
        "storage.modifier",
        "storage.type",
        "keyword.other.uses"
      ],
      "settings": {
        "foreground": "#6fbbe2"
      }
    },
    {
      "name": "Control flow (if, for, fail, return)",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ff8a6b"
      }
    },
    {
      "name": "Tests and contracts (test, assert)",
      "scope": [
        "keyword.other.test",
        "keyword.other.contract"
      ],
      "settings": {
        "foreground": "#c9a2ff"
      }
    },
    {
      "name": "Effects (fs, net)",
      "scope": [
        "support.constant.effect"
      ],
      "settings": {
        "foreground": "#62d0c2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#62d0c2"
      }
    },
    {
      "name": "Function names",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#8fb4ff"
      }
    },
    {
      "name": "Function calls and built-ins",
      "scope": [
        "entity.name.function.call",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#8fb4ff"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a8d99a"
      }
    },
    {
      "name": "Interpolation braces",
      "scope": [
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#ff9ec2"
      }
    },
    {
      "name": "Escapes and format specs",
      "scope": [
        "constant.character.escape",
        "constant.other.format-spec"
      ],
      "settings": {
        "foreground": "#ff9ec2"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#f2c27b"
      }
    },
    {
      "name": "true, false, none",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#f2c27b"
      }
    },
    {
      "name": "self",
      "scope": [
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#6fbbe2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable.other"
      ],
      "settings": {
        "foreground": "#dbe7ed"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#8fa6b3"
      }
    },
    {
      "name": "Error operators (? ! T? T!)",
      "scope": [
        "keyword.operator.try",
        "keyword.operator.type-suffix",
        "keyword.operator.optional-chain"
      ],
      "settings": {
        "foreground": "#ff8a6b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.brackets",
        "punctuation.section.braces"
      ],
      "settings": {
        "foreground": "#8fa6b3"
      }
    },
    {
      "name": "Holes (??)",
      "scope": [
        "invalid.illegal.hole"
      ],
      "settings": {
        "foreground": "#ff6b4a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff6b4a",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#62d0c2",
    "enum": "#62d0c2",
    "enumMember": "#62d0c2",
    "struct": "#62d0c2",
    "function": "#8fb4ff",
    "method": "#8fb4ff",
    "parameter": {
      "foreground": "#dbe7ed",
      "italic": true
    },
    "variable": "#dbe7ed",
    "property": "#dbe7ed",
    "keyword": "#6fbbe2",
    "string": "#a8d99a",
    "number": "#f2c27b",
    "comment": {
      "foreground": "#7891a0",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#62d0c2",
      "italic": true
    }
  }
}
