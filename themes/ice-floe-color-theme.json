  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5f7684",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords (fn, let, enum, uses)",
      "scope": [
        "keyword.other",
        "storage.modifier",
        "storage.type",
        "keyword.other.uses"
      ],
      "settings": {
        "foreground": "#1a6b94"
      }
    },
    {
      "name": "Control flow (if, for, fail, return)",
      "scope": [
        "keyword.control"
      ],
      "settings": {
        "foreground": "#bf4324"
      }
    },
    {
      "name": "Tests and contracts (test, assert)",
      "scope": [
        "keyword.other.test",
        "keyword.other.contract"
      ],
      "settings": {
        "foreground": "#8a4fb0"
      }
    },
    {
      "name": "Effects (fs, net)",
      "scope": [
        "support.constant.effect"
      ],
      "settings": {
        "foreground": "#0e7c86",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#0d6e7a"
      }
    },
    {
      "name": "Function names",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#2b4fa3"
      }
    },
    {
      "name": "Function calls and built-ins",
      "scope": [
        "entity.name.function.call",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#2b4fa3"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#3d7a2f"
      }
    },
    {
      "name": "Interpolation braces",
      "scope": [
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#b5426b"
      }
    },
    {
      "name": "Escapes and format specs",
      "scope": [
        "constant.character.escape",
        "constant.other.format-spec"
      ],
      "settings": {
        "foreground": "#b5426b"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9a5c0a"
      }
    },
    {
      "name": "true, false, none",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#9a5c0a"
      }
    },
    {
      "name": "self",
      "scope": [
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#1a6b94",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable.other"
      ],
      "settings": {
        "foreground": "#12212b"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#5a6f7c"
      }
    },
    {
      "name": "Error operators (? ! T? T!)",
      "scope": [
        "keyword.operator.try",
        "keyword.operator.type-suffix",
        "keyword.operator.optional-chain"
      ],
      "settings": {
        "foreground": "#bf4324",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.brackets",
        "punctuation.section.braces"
      ],
      "settings": {
        "foreground": "#5a6f7c"
      }
    },
    {
      "name": "Holes (??)",
      "scope": [
        "invalid.illegal.hole"
      ],
      "settings": {
        "foreground": "#c43c20",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#c43c20",
        "fontStyle": "underline"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#0d6e7a",
    "enum": "#0d6e7a",
    "enumMember": "#0d6e7a",
    "struct": "#0d6e7a",
    "function": "#2b4fa3",
    "method": "#2b4fa3",
    "parameter": {
      "foreground": "#12212b",
      "italic": true
    },
    "variable": "#12212b",
    "property": "#12212b",
    "keyword": "#1a6b94",
    "string": "#3d7a2f",
    "number": "#9a5c0a",
    "comment": {
      "foreground": "#5f7684",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#0d6e7a",
      "italic": true
    }
  }
}
